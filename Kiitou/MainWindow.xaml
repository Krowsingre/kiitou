<Window x:Class="Kiitou.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kiitou" Width="720" Height="450" MinWidth="720" MinHeight="450"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#1A1D26">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Kiitou" FontSize="34" FontWeight="SemiBold"
                       Foreground="#F5F5F7" HorizontalAlignment="Center"/>
            <TextBlock Text="Application foundation initialized"
                       Margin="0,12,0,0" FontSize="14" Foreground="#C2C6D1"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="StorageStatus" TextWrapping="Wrap"
                       MaxWidth="540" Margin="0,12,0,0"
                       FontSize="12" Foreground="#AAB0BF"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
