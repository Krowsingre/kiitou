<Window x:Class="Kiitou.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kiitou – Host Mapping Manager" Width="1040" Height="622" MinWidth="1040" MaxWidth="1040" MinHeight="622" MaxHeight="622"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="12.5" UseLayoutRounding="True">
    <!--
        The window has one fixed size, so every row below is laid out to fit it exactly.
        Button rows are single-row panels, never wrapping ones. Buttons that belong to one row
        share a name prefix ending in "Bar"; the build's layout check uses that to confirm each
        row stays on one line, inside the window, with no overlaps.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--
            Header. The right-hand group is as wide as the right-hand card on the Settings page
            (set in code), so the profile drop-down ends exactly where the left-hand card ends and
            the state badge ends exactly where the cards end. Every gap between groups is 12.
        -->
        <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}"
                BorderThickness="0,0,0,1" Padding="12,8">
            <Grid x:Name="HeaderGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition x:Name="HeaderRightHalf" Width="420"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="HeaderIcon" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Grid.Column="1" Margin="10,0,24,0" VerticalAlignment="Center">
                    <TextBlock Text="Kiitou" FontSize="19" FontWeight="Bold"/>
                    <TextBlock Text="Profile-Based Host Mapping" Foreground="{DynamicResource Muted}" FontSize="11"/>
                </StackPanel>
                <TextBlock x:Name="ProfileLabel" Grid.Column="2" Text="Profile:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="ProfilePicker" Grid.Column="3" HorizontalAlignment="Stretch"
                          VerticalAlignment="Center" SelectionChanged="ProfilePicker_SelectionChanged"/>
                <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="ApplyButton" Style="{StaticResource AccentBtn}" Margin="0,0,12,0"
                            Padding="14,7" MinWidth="158" Click="Apply_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ApplyGlyph" Style="{StaticResource Glyph}" Text="&#xE768;"/>
                            <TextBlock x:Name="ApplyText" Text="Apply Profile"/>
                        </StackPanel>
                    </Button>
                    <Border x:Name="StatePill" CornerRadius="5" Padding="12,6"
                            Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="StateGlyph" Style="{StaticResource Glyph}" Text="&#xE73E;"/>
                            <TextBlock x:Name="StateText" Text="Profile Active" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left navigation -->
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
                <ListBox x:Name="Nav" Margin="6,8" SelectionChanged="Nav_SelectionChanged" FontSize="13">
                    <ListBoxItem x:Name="NavHome" IsSelected="True">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE80F;" Margin="0,0,10,0"/><TextBlock Text="Home"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="NavWebsites">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE774;" Margin="0,0,10,0"/><TextBlock Text="Websites"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="NavProfiles">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE81E;" Margin="0,0,10,0"/><TextBlock Text="Profiles"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="NavDiscovery">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" Margin="0,0,10,0"/><TextBlock Text="Discovery &amp; Test"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="NavHosts">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8A5;" Margin="0,0,10,0"/><TextBlock Text="Hosts File"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="NavSettings">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" Margin="0,0,10,0"/><TextBlock Text="Settings"/></StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Border>

            <Grid x:Name="ContentHost" Grid.Column="1" Margin="12">

                <!-- ============ Home ============ -->
                <Grid x:Name="ViewHome">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="HomeBarAdd" Margin="0,0,6,0" Click="AddWebsite_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE710;"/><TextBlock Text="Add Website"/></StackPanel></Button>
                        <Button x:Name="HomeBarEdit" Margin="0,0,6,0" Click="HomeEdit_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE70F;"/><TextBlock Text="Edit"/></StackPanel></Button>
                        <Button x:Name="HomeBarRemove" Margin="0,0,18,0" Click="HomeRemove_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;"/><TextBlock Text="Remove"/></StackPanel></Button>
                        <Button x:Name="HomeBarEnableAll" Margin="0,0,6,0" Click="EnableAll_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE930;" Foreground="{DynamicResource Success}"/><TextBlock Text="Enable All"/></StackPanel></Button>
                        <Button x:Name="HomeBarDisableAll" Margin="0,0,18,0" Click="DisableAll_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE711;"/><TextBlock Text="Disable All"/></StackPanel></Button>
                        <Button x:Name="HomeBarDiscover" Margin="0,0,6,0" Click="HomeDiscover_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;"/><TextBlock Text="Discover DNS"/></StackPanel></Button>
                        <Button x:Name="HomeBarTest" Margin="0" Click="HomeTest_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE768;"/><TextBlock Text="Test Addresses"/></StackPanel></Button>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="280"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" TextChanged="HomeFilter_Changed" ToolTip="Show only websites whose hostname or addresses contain this text"/>
                        <TextBlock x:Name="SearchHint" Text="Search websites and addresses" Foreground="{DynamicResource Muted}"
                                   IsHitTestVisible="False" VerticalAlignment="Center" Margin="9,0,0,0"/>
                        <TextBlock Grid.Column="1" Text="Show:" VerticalAlignment="Center" Margin="12,0,8,0"/>
                        <ComboBox x:Name="FilterBox" Grid.Column="2" SelectionChanged="HomeFilter_Changed"/>
                    </Grid>

                    <DataGrid x:Name="HomeGrid" Grid.Row="2" Margin="0,0,0,8">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Enabled" Width="66">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" HorizontalAlignment="Center"
                                                  Click="HomeEnabled_Click" ToolTip="Include this website when the profile is applied"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Website (Hostname)" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Hostname}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Hostname}"/>
                                            <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Selected IP Address" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- One drop-down per address family the website has candidates for. -->
                                        <UniformGrid Columns="1">
                                            <ComboBox Tag="IPv4" ItemsSource="{Binding Ipv4Options}" SelectedItem="{Binding Ipv4Selected, Mode=OneWay}"
                                                      Visibility="{Binding Ipv4Visibility}" Margin="0,2" ToolTip="{Binding Ipv4Selected}"
                                                      SelectionChanged="HomeAddress_SelectionChanged"/>
                                            <ComboBox Tag="IPv6" ItemsSource="{Binding Ipv6Options}" SelectedItem="{Binding Ipv6Selected, Mode=OneWay}"
                                                      Visibility="{Binding Ipv6Visibility}" Margin="0,2" ToolTip="{Binding Ipv6Selected}"
                                                      SelectionChanged="HomeAddress_SelectionChanged"/>
                                        </UniformGrid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Addresses" Binding="{Binding AddressCount}" Width="80"/>
                            <DataGridTemplateColumn Header="Status" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="{Binding StatusGlyph}" Foreground="{Binding StatusBrush}"/>
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="3" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="2,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE81E;" FontSize="17" Foreground="{DynamicResource Accent}"/>
                                    <TextBlock x:Name="CardProfileName" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="CardCounts" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                                <TextBlock x:Name="CardSaved" Style="{StaticResource MutedText}"/>
                            </StackPanel>
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Button x:Name="SaveCurrentButton" Margin="0" Click="SaveCurrent_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;"/><TextBlock Text="Save to Current Profile"/></StackPanel></Button>
                                <Button x:Name="CardImport" Grid.Column="2" Margin="0" Click="ImportProfile_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE896;"/><TextBlock Text="Import Profile..."/></StackPanel></Button>
                                <Button x:Name="CardSaveAs" Grid.Row="2" Margin="0" Click="SaveAsNew_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE792;"/><TextBlock Text="Save as New Profile..."/></StackPanel></Button>
                                <Button x:Name="CardExport" Grid.Row="2" Grid.Column="2" Margin="0" Click="ExportProfile_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE898;"/><TextBlock Text="Export Profile..."/></StackPanel></Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============ Websites ============ -->
                <Grid x:Name="ViewWebsites" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Websites" Style="{StaticResource Heading}"/>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
                            <ListBox x:Name="WebsiteList" SelectionChanged="WebsiteList_SelectionChanged"/>
                        </Border>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="SiteBarAdd" Content="Add..." Margin="0,0,6,0" MinWidth="70" Click="AddWebsite_Click"/>
                            <Button x:Name="SiteBarRename" Content="Rename..." Margin="0,0,6,0" MinWidth="80" Click="RenameWebsite_Click"/>
                            <Button x:Name="SiteBarRemove" Content="Remove" Margin="0" MinWidth="76" Click="RemoveWebsite_Click"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="WebsiteTitle" Style="{StaticResource Heading}" Text="Select a website" TextTrimming="CharacterEllipsis"/>
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <CheckBox x:Name="WebsiteEnabled" Grid.ColumnSpan="2" Content="Enabled in the current selection"
                                      Click="WebsiteEnabled_Click" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="1" Text="Active IPv4 address:" VerticalAlignment="Center" Margin="0,0,10,6"/>
                            <ComboBox x:Name="WebsiteIpv4" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" SelectionChanged="WebsiteFamily_SelectionChanged"/>
                            <TextBlock Grid.Row="2" Text="Active IPv6 address:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="WebsiteIpv6" Grid.Row="2" Grid.Column="1" SelectionChanged="WebsiteFamily_SelectionChanged"/>
                        </Grid>
                        <DataGrid x:Name="AddressGrid" Grid.Row="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Candidate Address" Binding="{Binding IpAddress}" Width="*"/>
                                <DataGridTextColumn Header="Family" Binding="{Binding Family}" Width="62"/>
                                <DataGridTemplateColumn Header="Status" Width="220">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="{Binding StatusGlyph}" Foreground="{Binding StatusBrush}"/>
                                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="AddrBarAdd" Content="Add Address..." Margin="0,0,6,0" Click="AddAddress_Click"/>
                            <Button x:Name="AddrBarEdit" Content="Edit Address..." Margin="0,0,6,0" Click="EditAddress_Click"/>
                            <Button x:Name="AddrBarRemove" Content="Remove Address" Margin="0" Click="RemoveAddress_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ============ Profiles ============ -->
                <Grid x:Name="ViewProfiles" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Profiles" Style="{StaticResource Heading}"/>
                    <DataGrid x:Name="ProfileGrid" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Profile" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Enabled Websites" Binding="{Binding Enabled}" Width="130"/>
                            <DataGridTextColumn Header="Last Saved" Binding="{Binding LastSaved}" Width="150"/>
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="230"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,6">
                        <Button x:Name="ProfBarSwitch" Content="Switch To" Margin="0,0,6,0" MinWidth="86" Click="ProfileSwitch_Click" Style="{StaticResource AccentBtn}"/>
                        <Button x:Name="ProfBarNew" Content="New..." Margin="0,0,6,0" MinWidth="76" Click="ProfileNew_Click"/>
                        <Button x:Name="ProfBarRename" Content="Rename..." Margin="0,0,6,0" MinWidth="76" Click="ProfileRename_Click"/>
                        <Button x:Name="ProfBarDuplicate" Content="Duplicate" Margin="0,0,6,0" MinWidth="76" Click="ProfileDuplicate_Click"/>
                        <Button x:Name="ProfBarDelete" Content="Delete" Margin="0" MinWidth="76" Click="ProfileDelete_Click"/>
                    </StackPanel>
                    <TextBlock Grid.Row="3" Style="{StaticResource MutedText}"
                               Text="Switching and saving never change the Windows hosts file. Only Apply Selected Profile does. Import and export are on Home."/>
                </Grid>

                <!-- ============ Discovery & Test ============ -->
                <Grid x:Name="ViewDiscovery" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="118"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Website picker and its actions share one row. -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Website:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="DiscoverySite" Width="250" Margin="0,0,14,0" SelectionChanged="DiscoverySite_SelectionChanged"/>
                        <Button x:Name="TestBarDiscover" Content="Discover DNS" Margin="0,0,6,0" Click="Discover_Click"/>
                        <Button x:Name="TestBarSelected" Content="Test Selected" Margin="0,0,6,0" Click="TestSelected_Click"/>
                        <Button x:Name="TestBarAll" Content="Test All" Margin="0,0,6,0" Click="TestAll_Click"/>
                        <Button x:Name="TestBarFirst" Content="Find First Working" Margin="0,0,6,0" Click="FindFirst_Click"/>
                        <Button x:Name="TestBarCancel" Content="Cancel" Margin="0" Click="Cancel_Click" IsEnabled="False"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="DiscoverySummary" Style="{StaticResource MutedText}"
                                           Text="Discover DNS looks up the addresses currently published for the website."/>
                                <ListBox x:Name="DiscoveredList" Grid.Row="1" Margin="0,6,0,6">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Checked, Mode=TwoWay}" Content="{Binding IpAddress}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button x:Name="AddDiscoveredButton" Grid.Row="2" Content="Add Ticked as Candidates" Margin="0"
                                        Click="AddDiscovered_Click" IsEnabled="False"/>
                            </Grid>
                        </Border>
                        <DataGrid x:Name="TestGrid" Grid.Column="1" SelectionChanged="TestGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Address" Binding="{Binding IpAddress}" Width="*"/>
                                <DataGridTemplateColumn Header="Status" Width="220">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="{Binding StatusGlyph}" Foreground="{Binding StatusBrush}"/>
                                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Time" Binding="{Binding Timing}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="Why this status" FontWeight="SemiBold" Margin="0,8,0,4"/>
                    <TextBox x:Name="TestDetail" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                    <Grid Grid.Row="4" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="UseBarSelect" Content="Use Selected Address" Margin="0,0,6,0" Click="UseSelectedAddress_Click"
                                    ToolTip="Choose this address for the website. Nothing is written to the hosts file until you apply the profile."/>
                            <Button x:Name="UseBarBrowser" Content="Open Website in Browser" Margin="0" Click="OpenInBrowser_Click"
                                    ToolTip="For sites that show a browser challenge. The browser uses the mappings currently applied in Windows."/>
                        </StackPanel>
                        <TextBlock x:Name="TestCaveat" Grid.Column="1" Style="{StaticResource MutedText}" Margin="14,0,0,0"
                                   VerticalAlignment="Center" FontSize="11"/>
                    </Grid>
                </Grid>

                <!-- ============ Hosts File ============ -->
                <Grid x:Name="ViewHosts" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="HostsSummary" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="HostBarRefresh" Content="Refresh" Margin="0" MinWidth="76" Click="HostsRefresh_Click"/>
                    </StackPanel>
                    <TextBox x:Name="HostsText" Grid.Row="2" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"/>
                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Backups:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="BackupList" Grid.Column="1" Margin="0,0,8,0"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="BackupBarRestore" Content="Restore Selected Backup" Margin="0,0,6,0" Click="HostsRestore_Click"/>
                            <Button x:Name="BackupBarOpen" Content="Open Backup Folder" Margin="0" Click="OpenBackups_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ============ Settings ============ -->
                <!-- Cards are separated by the same 12 used around the page. -->
                <Grid x:Name="ViewSettings" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="AppearanceCard" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Appearance" Style="{StaticResource CardTitle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Theme Color" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="ThemeColorBox" SelectionChanged="ThemeColor_Changed">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Width="14" Height="14" CornerRadius="3" Background="{Binding Swatch}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Mode" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="ModeBox" SelectionChanged="Mode_Changed"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border x:Name="SystemCard" Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="System" Style="{StaticResource CardTitle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Minimize to system tray" FontWeight="SemiBold"/>
                                            <TextBlock Style="{StaticResource MutedText}" Text="Kiitou hides to the system tray when minimized."/>
                                        </StackPanel>
                                        <CheckBox x:Name="TrayOption" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                                  Click="TrayOption_Click" ToolTip="Minimize to system tray"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border x:Name="ReputationCard" Grid.Row="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Reputation Checks" Style="{StaticResource CardTitle}" Margin="0,0,0,1"/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,5"
                                           Text="Services asked whether a website or address is known to be malicious. A service is only contacted while it is switched on."/>
                                <Grid x:Name="ReputationTable">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="270"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="22"/>
                                        <RowDefinition Height="33"/>
                                        <RowDefinition Height="44"/>
                                        <RowDefinition Height="44"/>
                                        <RowDefinition Height="33"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.ColumnSpan="4" Background="{DynamicResource PanelAlt}" CornerRadius="4"/>
                                    <TextBlock Text="Service" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <TextBlock Grid.Column="1" Text="Configuration" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="Test" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="Enabled" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border Grid.Row="2" Grid.ColumnSpan="4" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"/>
                                    <Border Grid.Row="3" Grid.ColumnSpan="4" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"/>
                                    <Border Grid.Row="4" Grid.ColumnSpan="4" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"/>

                                    <!-- Quad9 -->
                                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Text="Quad9" FontWeight="SemiBold"/>
                                        <TextBlock Text="Checks the website name." Foreground="{DynamicResource Muted}" FontSize="11"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="No account needed" FontStyle="Italic"
                                               Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="&#x2014;" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="22,0,0,0"/>
                                    <CheckBox x:Name="Quad9Option" Grid.Row="1" Grid.Column="3" Style="{StaticResource Switch}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" Click="Quad9Option_Click" ToolTip="Quad9"/>

                                    <!-- Key-based service, first row -->
                                    <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <ComboBox x:Name="SlotService0" Tag="0" Width="220" HorizontalAlignment="Left" MinHeight="26"
                                                  SelectionChanged="SlotService_Changed"/>
                                        <TextBlock x:Name="SlotHint0" Foreground="{DynamicResource Muted}" FontSize="11" Margin="1,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Grid Width="250">
                                            <PasswordBox x:Name="SlotKey0" Tag="0" Padding="6,4,30,4" LostFocus="SlotKey_LostFocus"/>
                                            <TextBox x:Name="SlotKeyPlain0" Tag="0" Padding="6,4,30,4" Visibility="Collapsed" LostFocus="SlotKey_LostFocus"/>
                                            <TextBlock x:Name="SlotKeyHint0" Text="Paste your API key" Foreground="{DynamicResource Muted}"
                                                       IsHitTestVisible="False" VerticalAlignment="Center" Margin="9,0,0,0"/>
                                            <ToggleButton x:Name="SlotEye0" Tag="0" Style="{StaticResource EyeToggle}" HorizontalAlignment="Right"
                                                          Click="SlotEye_Click" ToolTip="Show or hide the key"/>
                                        </Grid>
                                        <Button x:Name="SlotLink0" Tag="0" Style="{StaticResource LinkBtn}" Content="Get a free key" Margin="12,0,0,0"
                                                VerticalAlignment="Center" Click="SlotLink_Click"/>
                                        <TextBlock x:Name="SlotStatus0" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button x:Name="SlotTest0" Tag="0" Grid.Row="2" Grid.Column="2" Content="Test Key" Margin="0" MinWidth="76"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" Click="SlotTest_Click"/>
                                    <CheckBox x:Name="SlotToggle0" Tag="0" Grid.Row="2" Grid.Column="3" Style="{StaticResource Switch}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" Click="SlotToggle_Click"/>

                                    <!-- Key-based service, second row -->
                                    <StackPanel Grid.Row="3" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <ComboBox x:Name="SlotService1" Tag="1" Width="220" HorizontalAlignment="Left" MinHeight="26"
                                                  SelectionChanged="SlotService_Changed"/>
                                        <TextBlock x:Name="SlotHint1" Foreground="{DynamicResource Muted}" FontSize="11" Margin="1,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Grid Width="250">
                                            <PasswordBox x:Name="SlotKey1" Tag="1" Padding="6,4,30,4" LostFocus="SlotKey_LostFocus"/>
                                            <TextBox x:Name="SlotKeyPlain1" Tag="1" Padding="6,4,30,4" Visibility="Collapsed" LostFocus="SlotKey_LostFocus"/>
                                            <TextBlock x:Name="SlotKeyHint1" Text="Paste your API key" Foreground="{DynamicResource Muted}"
                                                       IsHitTestVisible="False" VerticalAlignment="Center" Margin="9,0,0,0"/>
                                            <ToggleButton x:Name="SlotEye1" Tag="1" Style="{StaticResource EyeToggle}" HorizontalAlignment="Right"
                                                          Click="SlotEye_Click" ToolTip="Show or hide the key"/>
                                        </Grid>
                                        <Button x:Name="SlotLink1" Tag="1" Style="{StaticResource LinkBtn}" Content="Get a free key" Margin="12,0,0,0"
                                                VerticalAlignment="Center" Click="SlotLink_Click"/>
                                        <TextBlock x:Name="SlotStatus1" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button x:Name="SlotTest1" Tag="1" Grid.Row="3" Grid.Column="2" Content="Test Key" Margin="0" MinWidth="76"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" Click="SlotTest_Click"/>
                                    <CheckBox x:Name="SlotToggle1" Tag="1" Grid.Row="3" Grid.Column="3" Style="{StaticResource Switch}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" Click="SlotToggle_Click"/>

                                    <!-- Custom filtering DNS server -->
                                    <StackPanel Grid.Row="4" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Text="Custom DNS" FontWeight="SemiBold"/>
                                        <TextBlock Text="Checks the website name through a DNS provider." Foreground="{DynamicResource Muted}" FontSize="11"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Grid Width="150">
                                            <TextBox x:Name="DnsName" LostFocus="Dns_LostFocus" TextChanged="DnsHint_Changed"/>
                                            <TextBlock x:Name="DnsNameHint" Text="Name" Foreground="{DynamicResource Muted}"
                                                       IsHitTestVisible="False" VerticalAlignment="Center" Margin="9,0,0,0"/>
                                        </Grid>
                                        <Grid Width="130" Margin="8,0,0,0">
                                            <TextBox x:Name="DnsServer" LostFocus="Dns_LostFocus" TextChanged="DnsHint_Changed"/>
                                            <TextBlock x:Name="DnsServerHint" Text="1.1.1.2" Foreground="{DynamicResource Muted}"
                                                       IsHitTestVisible="False" VerticalAlignment="Center" Margin="9,0,0,0"/>
                                        </Grid>
                                        <TextBlock x:Name="DnsStatus" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button x:Name="DnsTest" Grid.Row="4" Grid.Column="2" Content="Test" Margin="0" MinWidth="76"
                                            HorizontalAlignment="Left" VerticalAlignment="Center" Click="DnsTest_Click"/>
                                    <CheckBox x:Name="DnsToggle" Grid.Row="4" Grid.Column="3" Style="{StaticResource Switch}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" Click="DnsToggle_Click" ToolTip="Custom DNS"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="9*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="StorageCard" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Storage" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="StorageText" Style="{StaticResource MutedText}"/>
                                    <TextBlock x:Name="StorageFolder" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="StorageBackups" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="AboutCard" Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="About" Style="{StaticResource CardTitle}"/>
                                    <TextBlock x:Name="AboutVersion" FontWeight="SemiBold" Margin="0,0,0,1"/>
                                    <TextBlock x:Name="AboutText" Style="{StaticResource MutedText}" FontSize="11.5"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- Status footer -->
        <Border x:Name="FooterBar" Grid.Row="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}"
                BorderThickness="0,1,0,0" Padding="12,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="FooterGlyph" Style="{StaticResource Glyph}" Text="&#xE930;"/>
                    <TextBlock Text="Hosts File: " FontWeight="SemiBold"/>
                    <TextBlock x:Name="FooterHosts"/>
                </StackPanel>
                <TextBlock x:Name="FooterMessage" Grid.Column="1" Margin="18,0" Foreground="{DynamicResource Muted}"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE81C;"/>
                    <TextBlock x:Name="FooterApplied"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
