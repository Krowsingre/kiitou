<Window x:Class="Kiitou.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kiitou" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="12.5" UseLayoutRounding="True">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBox x:Name="ValueBox"/>
        <TextBlock x:Name="HintText" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkButton" Content="OK" IsDefault="True" MinWidth="84" Style="{StaticResource AccentBtn}" Click="Ok_Click"/>
            <Button Content="Cancel" IsCancel="True" MinWidth="84" Margin="0,0,0,6"/>
        </StackPanel>
    </StackPanel>
</Window>
