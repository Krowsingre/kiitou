<Window x:Class="Kiitou.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kiitou – Updating" Width="1040" Height="622" ResizeMode="CanMinimize"
        WindowStartupLocation="Manual"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="12.5" UseLayoutRounding="True">
    <!--
        Shown in place of Kiitou while an update installs: the same size and position, with a
        blurred picture of Kiitou as it was behind a card that reports progress.
    -->
    <Grid>
        <Image x:Name="Snapshot" Stretch="Fill">
            <Image.Effect>
                <BlurEffect Radius="14" KernelType="Gaussian"/>
            </Image.Effect>
        </Image>
        <Rectangle x:Name="Dim" Fill="{DynamicResource Bg}" Opacity="0.55"/>

        <Border x:Name="UpdateCard" Style="{StaticResource Card}" Width="380" MinHeight="220"
                HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,20">
            <StackPanel VerticalAlignment="Center">
                <Image x:Name="CardIcon" Width="48" Height="48" HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,10"/>
                <TextBlock x:Name="Heading" Text="Updating Kiitou" FontSize="17" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="Versions" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,2,0,14"/>

                <StackPanel x:Name="ProgressPanel">
                    <ProgressBar x:Name="Progress" Width="300" Height="6" Minimum="0" Maximum="1"
                                 Foreground="{DynamicResource Accent}" Background="{DynamicResource Control}" BorderThickness="0"/>
                    <TextBlock x:Name="Status" HorizontalAlignment="Center" Margin="0,10,0,0" Foreground="{DynamicResource Muted}"/>
                </StackPanel>

                <StackPanel x:Name="ErrorPanel" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,14"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="TryAgainButton" Content="Try Again" Style="{StaticResource AccentBtn}" MinWidth="100"
                                Margin="0,0,10,0" Click="TryAgain_Click"/>
                        <Button x:Name="OpenKiitouButton" Content="Open Kiitou" MinWidth="100" Margin="0" Click="OpenKiitou_Click"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
