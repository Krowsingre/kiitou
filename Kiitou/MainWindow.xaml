<Window x:Class="Kiitou.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kiitou – Host Mapping Manager" Width="900" Height="600" MinWidth="720" MinHeight="450"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="12.5" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: icon, name, profile picker, apply, state -->
        <Border Grid.Row="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}"
                BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="HeaderIcon" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Grid.Column="1" Margin="10,0,18,0" VerticalAlignment="Center">
                    <TextBlock Text="Kiitou" FontSize="19" FontWeight="Bold"/>
                    <TextBlock Text="Profile-Based Host Mapping" Foreground="{DynamicResource Muted}" FontSize="11"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="Profile:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="ProfilePicker" Grid.Column="3" MaxWidth="260" HorizontalAlignment="Stretch"
                          VerticalAlignment="Center" SelectionChanged="ProfilePicker_SelectionChanged"
                          ToolTip="Choose the profile to edit and apply"/>
                <Button x:Name="ApplyButton" Grid.Column="4" Style="{StaticResource AccentBtn}" Margin="10,0,10,0"
                        Padding="14,7" VerticalAlignment="Center" Click="Apply_Click"
                        ToolTip="Write the selected profile's mappings to the Windows hosts file">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;"/>
                        <TextBlock Text="Apply Selected Profile"/>
                    </StackPanel>
                </Button>
                <Border x:Name="StatePill" Grid.Column="5" CornerRadius="5" Padding="10,6" VerticalAlignment="Center"
                        Background="{DynamicResource PanelAlt}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="StateGlyph" Style="{StaticResource Glyph}" Text="&#xE930;"/>
                        <TextBlock x:Name="StateText" Text="Not Applied" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="158"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left navigation -->
            <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
                <ListBox x:Name="Nav" Margin="6,8" SelectionChanged="Nav_SelectionChanged" FontSize="13">
                    <ListBoxItem x:Name="NavHome" IsSelected="True">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE80F;" Margin="0,0,10,0"/><TextBlock Text="Home"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="NavWebsites">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE774;" Margin="0,0,10,0"/><TextBlock Text="Websites"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="NavProfiles">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE81E;" Margin="0,0,10,0"/><TextBlock Text="Profiles"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="NavDiscovery">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" Margin="0,0,10,0"/><TextBlock Text="Discovery &amp; Test"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="NavVerification">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xEA18;" Margin="0,0,10,0"/><TextBlock Text="Verification"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="NavHosts">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8A5;" Margin="0,0,10,0"/><TextBlock Text="Hosts File"/></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="NavSettings">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" Margin="0,0,10,0"/><TextBlock Text="Settings"/></StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Border>

            <Grid Grid.Column="1" Margin="10,10,10,6">

                <!-- ============ Home ============ -->
                <Grid x:Name="ViewHome">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <WrapPanel>
                        <Button Click="AddWebsite_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE710;"/><TextBlock Text="Add Website"/></StackPanel></Button>
                        <Button Click="HomeEdit_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE70F;"/><TextBlock Text="Edit"/></StackPanel></Button>
                        <Button Click="HomeRemove_Click" Margin="0,0,16,6"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;"/><TextBlock Text="Remove"/></StackPanel></Button>
                        <Button Click="EnableAll_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE930;" Foreground="{DynamicResource Success}"/><TextBlock Text="Enable All"/></StackPanel></Button>
                        <Button Click="DisableAll_Click" Margin="0,0,16,6"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE711;"/><TextBlock Text="Disable All"/></StackPanel></Button>
                        <Button Click="HomeDiscover_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;"/><TextBlock Text="Discover DNS"/></StackPanel></Button>
                        <Button Click="HomeTest_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE768;"/><TextBlock Text="Test Addresses"/></StackPanel></Button>
                    </WrapPanel>

                    <DataGrid x:Name="HomeGrid" Grid.Row="1" Margin="0,2,0,8">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Enabled" Width="68">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" HorizontalAlignment="Center"
                                                  Click="HomeEnabled_Click" ToolTip="Include this website when the profile is applied"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Website (Hostname)" Width="1.1*" MinWidth="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Hostname}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Selected IP Address" Width="1.4*" MinWidth="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected, Mode=OneWay}"
                                                  SelectionChanged="HomeAddress_SelectionChanged"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Addresses" Binding="{Binding AddressCount}" Width="76"/>
                            <DataGridTemplateColumn Header="Status" Width="1.2*" MinWidth="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Glyph}" Text="{Binding StatusGlyph}" Foreground="{Binding StatusBrush}"/>
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="44">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="&#xE712;" FontFamily="{StaticResource IconFont}" Padding="6,3" Margin="0"
                                                MinHeight="22" BorderThickness="0" Background="Transparent"
                                                Click="HomeMore_Click" ToolTip="Open this website's addresses"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="2,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE81E;" FontSize="17" Foreground="{DynamicResource Accent}"/>
                                    <TextBlock x:Name="CardProfileName" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border x:Name="CardBadge" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                            BorderBrush="{DynamicResource Success}" BorderThickness="1">
                                        <TextBlock x:Name="CardBadgeText" Text="Active" Foreground="{DynamicResource Success}" FontSize="11"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="CardCounts" Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                                <TextBlock x:Name="CardSaved" Style="{StaticResource MutedText}"/>
                            </StackPanel>
                            <UniformGrid Grid.Column="1" Columns="2" VerticalAlignment="Center">
                                <Button x:Name="SaveCurrentButton" Click="SaveCurrent_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;"/><TextBlock Text="Save to Current Profile"/></StackPanel></Button>
                                <Button Click="ImportProfile_Click"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE896;"/><TextBlock Text="Import Profile..."/></StackPanel></Button>
                                <Button Click="SaveAsNew_Click" Margin="0,0,6,0"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE792;"/><TextBlock Text="Save as New Profile..."/></StackPanel></Button>
                                <Button Click="ExportProfile_Click" Margin="0,0,6,0"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE898;"/><TextBlock Text="Export Profile..."/></StackPanel></Button>
                            </UniformGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============ Websites ============ -->
                <Grid x:Name="ViewWebsites" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Websites" Style="{StaticResource Heading}"/>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
                            <ListBox x:Name="WebsiteList" SelectionChanged="WebsiteList_SelectionChanged"/>
                        </Border>
                        <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                            <Button Content="Add..." Click="AddWebsite_Click"/>
                            <Button Content="Rename..." Click="RenameWebsite_Click"/>
                            <Button Content="Remove" Click="RemoveWebsite_Click"/>
                        </WrapPanel>
                    </Grid>
                    <Grid Grid.Column="1" x:Name="WebsiteDetail">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="WebsiteTitle" Style="{StaticResource Heading}" Text="Select a website"/>
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <CheckBox x:Name="WebsiteEnabled" Grid.ColumnSpan="2" Content="Enabled in the current selection"
                                      Click="WebsiteEnabled_Click" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="1" Text="Active IPv4 address:" VerticalAlignment="Center" Margin="0,0,10,6"/>
                            <ComboBox x:Name="WebsiteIpv4" Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" SelectionChanged="WebsiteFamily_SelectionChanged"/>
                            <TextBlock Grid.Row="2" Text="Active IPv6 address:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="WebsiteIpv6" Grid.Row="2" Grid.Column="1" SelectionChanged="WebsiteFamily_SelectionChanged"/>
                        </Grid>
                        <DataGrid x:Name="AddressGrid" Grid.Row="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Candidate Address" Binding="{Binding IpAddress}" Width="1.5*"/>
                                <DataGridTextColumn Header="Family" Binding="{Binding Family}" Width="60"/>
                                <DataGridTemplateColumn Header="Status" Width="1.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" Text="{Binding StatusGlyph}" Foreground="{Binding StatusBrush}"/>
                                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Checked" Binding="{Binding Checked}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                            <Button Content="Add Address..." Click="AddAddress_Click"/>
                            <Button Content="Edit Address..." Click="EditAddress_Click"/>
                            <Button Content="Remove Address" Click="RemoveAddress_Click"/>
                            <Button Content="Test Selected" Click="WebsiteTestSelected_Click"/>
                        </WrapPanel>
                    </Grid>
                </Grid>

                <!-- ============ Profiles ============ -->
                <Grid x:Name="ViewProfiles" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Profiles" Style="{StaticResource Heading}"/>
                    <DataGrid x:Name="ProfileGrid" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Profile" Binding="{Binding Name}" Width="1.4*"/>
                            <DataGridTextColumn Header="Enabled Websites" Binding="{Binding Enabled}" Width="*"/>
                            <DataGridTextColumn Header="Last Saved" Binding="{Binding LastSaved}" Width="*"/>
                            <DataGridTextColumn Header="State" Binding="{Binding State}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="2" Margin="0,8,0,0">
                        <Button Content="Switch To" Click="ProfileSwitch_Click" Style="{StaticResource AccentBtn}"/>
                        <Button Content="New..." Click="ProfileNew_Click"/>
                        <Button Content="Rename..." Click="ProfileRename_Click"/>
                        <Button Content="Duplicate" Click="ProfileDuplicate_Click"/>
                        <Button Content="Delete" Click="ProfileDelete_Click" Margin="0,0,16,6"/>
                        <Button Content="Import Profile..." Click="ImportProfile_Click"/>
                        <Button Content="Export Profile..." Click="ProfileExportSelected_Click" Margin="0,0,16,6"/>
                        <Button Content="Import Website Collection..." Click="ImportCollection_Click"/>
                        <Button Content="Export Website Collection..." Click="ExportCollection_Click"/>
                    </WrapPanel>
                    <TextBlock Grid.Row="3" Style="{StaticResource MutedText}"
                               Text="Switching, saving, importing and exporting never change the Windows hosts file. Only Apply Selected Profile does."/>
                </Grid>

                <!-- ============ Discovery & Test ============ -->
                <Grid x:Name="ViewDiscovery" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Website:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,6"/>
                        <ComboBox x:Name="DiscoverySite" Grid.Column="1" MaxWidth="320" HorizontalAlignment="Left" MinWidth="220"
                                  Margin="0,0,0,6" SelectionChanged="DiscoverySite_SelectionChanged"/>
                    </Grid>
                    <WrapPanel Grid.Row="1">
                        <Button Content="Discover DNS" Click="Discover_Click"/>
                        <Button Content="Test Selected Address" Click="TestSelected_Click"/>
                        <Button Content="Test All" Click="TestAll_Click"/>
                        <Button Content="Find First Working" Click="FindFirst_Click"/>
                        <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" IsEnabled="False"/>
                    </WrapPanel>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="DiscoverySummary" Style="{StaticResource MutedText}"
                                           Text="Discover DNS looks up the addresses currently published for the website."/>
                                <ListBox x:Name="DiscoveredList" Grid.Row="1" Margin="0,6,0,6">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Checked, Mode=TwoWay}" Content="{Binding IpAddress}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button x:Name="AddDiscoveredButton" Grid.Row="2" Content="Add Ticked as Candidates" Margin="0"
                                        Click="AddDiscovered_Click" IsEnabled="False"/>
                            </Grid>
                        </Border>
                        <DataGrid x:Name="TestGrid" Grid.Column="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Address" Binding="{Binding IpAddress}" Width="1.3*"/>
                                <DataGridTemplateColumn Header="Status" Width="1.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Glyph}" Text="{Binding StatusGlyph}" Foreground="{Binding StatusBrush}"/>
                                                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Time" Binding="{Binding Timing}" Width="70"/>
                                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    <StackPanel Grid.Row="3" Margin="0,8,0,0">
                        <WrapPanel>
                            <Button Content="Use Selected Address" Click="UseSelectedAddress_Click"
                                    ToolTip="Choose this address for the website in the current selection. Nothing is applied until you apply the profile."/>
                            <Button Content="Open Website in Browser" Click="OpenInBrowser_Click"
                                    ToolTip="For sites that show a browser challenge. The browser uses the mappings currently applied in Windows."/>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource MutedText}"
                                   Text="Tests connect straight to each address without touching the hosts file. A passing test never selects or applies an address."/>
                    </StackPanel>
                </Grid>

                <!-- ============ Verification ============ -->
                <Grid x:Name="ViewVerification" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1.3*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <WrapPanel>
                        <Button Content="Verify Selected" Click="VerifySelected_Click"/>
                        <Button Content="Verify All Untested or Stale" Click="VerifyStale_Click"/>
                        <Button x:Name="CancelButton2" Content="Cancel" Click="Cancel_Click" IsEnabled="False"/>
                    </WrapPanel>
                    <DataGrid x:Name="VerifyGrid" Grid.Row="1" SelectionChanged="VerifyGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Website" Binding="{Binding Hostname}" Width="1.2*"/>
                            <DataGridTextColumn Header="Address" Binding="{Binding IpAddress}" Width="1.3*"/>
                            <DataGridTemplateColumn Header="Status" Width="1.6*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Glyph}" Text="{Binding StatusGlyph}" Foreground="{Binding StatusBrush}"/>
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Checked" Binding="{Binding Checked}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="Why this status" FontWeight="SemiBold" Margin="0,8,0,4"/>
                    <TextBox x:Name="VerifyDetail" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" AcceptsReturn="True" VerticalContentAlignment="Top"/>
                    <TextBlock x:Name="VerifyCaveat" Grid.Row="4" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                </Grid>

                <!-- ============ Hosts File ============ -->
                <Grid x:Name="ViewHosts" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="HostsSummary" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <WrapPanel Grid.Row="1">
                        <Button Content="Refresh" Click="HostsRefresh_Click"/>
                        <Button Content="Apply Selected Profile" Click="Apply_Click" Style="{StaticResource AccentBtn}"/>
                        <Button Content="Remove Kiitou Mappings" Click="HostsRemove_Click"
                                ToolTip="Remove every mapping Kiitou manages from the hosts file. Your saved websites and profiles are kept."/>
                    </WrapPanel>
                    <TextBox x:Name="HostsText" Grid.Row="2" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"/>
                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Backups:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,6"/>
                        <ComboBox x:Name="BackupList" Grid.Column="1" Margin="0,0,8,6"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="Restore Selected Backup" Click="HostsRestore_Click"/>
                            <Button Content="Open Backup Folder" Click="OpenBackups_Click" Margin="0,0,0,6"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ============ Settings ============ -->
                <ScrollViewer x:Name="ViewSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Appearance" Style="{StaticResource Heading}"/>
                        <TextBlock Text="Color" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <WrapPanel x:Name="ColorChoices" Margin="0,0,0,8"/>
                        <TextBlock Text="Mode" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <WrapPanel Margin="0,0,0,12">
                            <RadioButton x:Name="ModeDark" GroupName="Mode" Content="Dark" Click="Mode_Click"/>
                            <RadioButton x:Name="ModeLight" GroupName="Mode" Content="Light" Click="Mode_Click"/>
                        </WrapPanel>
                        <TextBlock Text="Notification area" Style="{StaticResource Heading}"/>
                        <CheckBox x:Name="TrayOption" Content="Show a notification-area icon and hide the window there when minimized"
                                  Click="TrayOption_Click" Margin="0,0,0,12"/>
                        <TextBlock Text="Storage" Style="{StaticResource Heading}"/>
                        <TextBlock x:Name="StorageText" Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
                        <TextBlock Text="About" Style="{StaticResource Heading}"/>
                        <TextBlock x:Name="AboutText" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Status footer -->
        <Border Grid.Row="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Border}"
                BorderThickness="0,1,0,0" Padding="12,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="FooterGlyph" Style="{StaticResource Glyph}" Text="&#xE930;"/>
                    <TextBlock Text="Hosts File: " FontWeight="SemiBold"/>
                    <TextBlock x:Name="FooterHosts"/>
                </StackPanel>
                <TextBlock x:Name="FooterMessage" Grid.Column="1" Margin="18,0" Foreground="{DynamicResource Muted}"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE81C;"/>
                    <TextBlock x:Name="FooterApplied"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
